# ============================================================
#  STEM Academia — Document Management System
#  Environment Configuration
#  ВАЖНО: Измените все секреты перед деплоем в продакшн!
# ============================================================

# --- Сервер ---
PORT=8080
GIN_MODE=debug          # debug | release

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=stem_doc_manager

# --- JWT (минимум 32 символа для секрета) ---
JWT_SECRET=very_secure_and_long_secret_key_for_jwt_signing 
JWT_ACCESS_EXPIRY=15m       # Время жизни access-токена
JWT_REFRESH_EXPIRY=168h     # Время жизни refresh-токена (7 дней)

# --- CORS (фронтенд-адрес) ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Rate Limiting (защита от DDoS) ---
RATE_LIMIT_GLOBAL=100       # Запросов в минуту на IP (все эндпоинты)
RATE_LIMIT_AUTH=10          # Запросов в минуту на IP (auth-эндпоинты, строже)

# --- Начальный администратор (создаётся при первом запуске) ---
SEED_ADMIN_EMAIL=admin@stem-academia.kz
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ADMIN_NAME=Администратор Системы
